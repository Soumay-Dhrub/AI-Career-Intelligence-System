# Supabase Configuration
# Get these from: https://app.supabase.com → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase

# Database Configuration (Supabase PostgreSQL)
# From: Supabase Dashboard → Project Settings → Database → Connection pooling
# IMPORTANT: URL-encode special characters in password:
#   @ becomes %40
#   # becomes %23
#   : becomes %3A (only in password part)
# Example: password "user@pass" → "user%40pass"
DATABASE_URL=postgresql://postgres:your-password@db.your-project-id.supabase.co:5432/postgres

# JWT Configuration (Legacy - kept for backward compatibility)
SECRET_KEY=your-super-secret-jwt-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Google OAuth (optional)
# Get from: https://console.cloud.google.com → OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Data Processing
DATA_DIR=data
PROCESSED_DATA_DIR=data/processed

# ML Models
MODEL_DIR=ml_models